            "description": "Cria a OS em RECEBIDA e publica OS_CRIADA via outbox. Grava o id em {{osId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solicitacao\": \"Troca de óleo e revisão de freios\",\n  \"idCliente\": \"{{clienteId}}\",\n  \"idVeiculo\": \"{{veiculoId}}\"\n}",
