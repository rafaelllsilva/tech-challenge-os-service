      "name": "Ordem de Serviço",
      "description": "Orçamento, pagamento e execução avançam por eventos do billing e do execution (SNS/SQS), não por endpoints REST.",
      "item": [
        {
          "name": "1. Abrir OS (publica OS_CRIADA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
